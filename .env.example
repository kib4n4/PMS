# Copy to .env and fill in. Never commit the real .env.

POSTGRES_DB=pms
POSTGRES_USER=pms
POSTGRES_PASSWORD=change-me

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=false
# Includes localhost so `docker compose up` is reachable at
# http://localhost:8000 out of the box — replace with your real
# domain(s) for a production deployment (Django rejects any Host header
# not listed here with a 400).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api.yourdomain.com

# Public HTTPS origin this backend is reachable at — used to build
# Safaricom Daraja callback URLs (CallBackURL/ResultURL/QueueTimeOutURL).
# Safaricom cannot reach localhost, so STK Push/B2C/reconciliation only
# work once this points at a real public URL.
PUBLIC_BASE_URL=https://api.yourdomain.com

# Fernet key used to encrypt every DB-stored third-party credential
# (Daraja, WhatsApp, Resend, KRA — see backend/credentials/fields.py).
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing/changing this key makes every previously-stored credential
# unrecoverable — back it up outside the DB.
CREDENTIAL_ENCRYPTION_KEY=change-me

# Frontend origin(s) allowed to call this API (comma-separated).
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Flat platform fee taken from every confirmed rent payment (0.05 = 5%).
# Still a single global rate — per-landlord rates are a documented
# Phase 4+ TODO (see backend/billing/tasks.py).
PLATFORM_FEE_RATE=0.05

# --- Platform-level third-party credentials ---
# Daraja, WhatsApp, Resend, and KRA credentials are DB-driven, not env
# vars: set them from Django admin (PlatformCredential /
# LandlordDarajaCredential / LandlordKRACredential) or the credentials
# API once it exists. Rotating a key is an admin-panel edit, not a
# redeploy.
