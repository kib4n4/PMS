# Copy to .env and fill in. Never commit the real .env.

POSTGRES_DB=pms
POSTGRES_USER=pms
POSTGRES_PASSWORD=change-me

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=api.yourdomain.com

# --- M2/M3/M4 wiring — not needed until real integration work starts ---
# Per-landlord Daraja credentials do NOT belong here — they belong in the
# secrets manager (Vault / AWS or GCP Secrets Manager), referenced by the
# *_secret_ref fields on LandlordDarajaCredential. Only the platform's own
# Daraja app and the secrets-manager connection details belong in env vars:
SECRETS_MANAGER_URL=
PLATFORM_DARAJA_CONSUMER_KEY_REF=secrets/platform/daraja/consumer_key
PLATFORM_DARAJA_CONSUMER_SECRET_REF=secrets/platform/daraja/consumer_secret
WHATSAPP_ACCESS_TOKEN_REF=secrets/platform/whatsapp/access_token
WHATSAPP_PHONE_NUMBER_ID_REF=secrets/platform/whatsapp/phone_number_id
